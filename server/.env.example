# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string (local example — replace with your Atlas URI in production)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_analytics

# Port the Express server listens on
PORT=5000

# Environment name — "production" enables strict CORS (CLIENT_URL only,
# no localhost fallback) and hides internal error details from responses
NODE_ENV=development

# The deployed frontend's origin, used for CORS. Required in production —
# if unset while NODE_ENV=production, cross-origin requests are rejected.
# Example: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173
